# OffensiveToolMapper environment template
# Скопируй файл в .env и впиши свои ключи:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# .env не коммитится в git. Docker Compose подхватывает его автоматически.

# -----------------------------------------------------------------------------
# 1. LLM provider. По умолчанию проект работает через OpenAI.
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Обязательно для LLM-стадий, если LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Необязательно. Заполняй только если OpenAI-аккаунт требует organization/project.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Альтернатива OpenAI. Нужен только если LLM_PROVIDER=deepseek.
# Для DeepSeek обычно ставят:
#   LLM_PROVIDER=deepseek
#   LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Необязательно. Для кастомного OpenAI-compatible endpoint.
# Оставь пустым для стандартных OpenAI/DeepSeek URL.
LLM_BASE_URL=

# Необязательно. Ограничивает число записей, отправляемых в LLM за запуск.
# Удобно для тестового запуска, например: LLM_MAX_RECORDS=20
LLM_MAX_RECORDS=

# -----------------------------------------------------------------------------
# 2. GitHub collection. Нужен для полноценного сбора репозиториев.
# -----------------------------------------------------------------------------
GITHUB_PAT=

# Режим сбора: incremental или snapshot.
OTM_COLLECT_MODE=incremental

# Ограничения GitHub discovery. Можно уменьшить для быстрого теста.
OTM_GITHUB_MIN_STARS=10
OTM_GITHUB_MAX_RESULTS=100
OTM_GITHUB_MAX_SEARCH_REQUESTS=60

# -----------------------------------------------------------------------------
# 3. Docker/UI/MCP. Обычно менять не нужно.
# -----------------------------------------------------------------------------
MODERN_UI_URL=http://localhost:5173
OTM_MCP_TRANSPORT=http
OTM_MCP_PORT=3000

# Для локального R обычно оставляют пустым: тогда используется inst/extdata.
# Docker Compose сам выставляет /app/inst/extdata внутри контейнеров.
OFFENSIVETOOLMAPPER_DATA_DIR=
